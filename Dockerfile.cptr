FROM python:3.11-slim

# 1. Base Utilities, Docker CLI, System Tools, ripgrep, gh, tmux, build-essential, Chromium
RUN apt-get update && apt-get install -y \
    curl \
    git \
    zsh \
    sudo \
    jq \
    nano \
    tmux \
    ripgrep \
    psmisc \
    build-essential \
    docker.io \
    docker-compose \
    chromium \
    chromium-driver \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Add chromium wrapper to run headless and no-sandbox in docker
RUN mv /usr/bin/chromium /usr/bin/chromium-real && \
    echo '#!/bin/bash\nARGS=()\nfor arg in "$@"; do\n  if [[ "$arg" == "--enable-gpu-rasterization" || "$arg" == "--use-angle=swiftshader-webgl" ]]; then\n    continue\n  fi\n  ARGS+=("$arg")\ndone\nexec /usr/bin/chromium-real --no-sandbox --headless --disable-gpu --disable-software-rasterizer --disable-dev-shm-usage --mute-audio --hide-scrollbars "${ARGS[@]}"' > /usr/bin/chromium && \
    chmod +x /usr/bin/chromium

# 2. Node.js 22 Setup
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 3. Tailscale Installation
RUN curl -fsSL https://tailscale.com/install.sh | sh

# 4. Install Global CLI Tools (as root so they land in /usr/local/bin)
RUN npm install -g pnpm pm2 @anthropic-ai/claude-code @modelcontextprotocol/server-github @infisical/cli vercel && \
    curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin

# 5. Additional Python AI applications & cptr as root
RUN pip install --no-cache-dir --upgrade "cptr[all]==0.9.21" aider-chat

# 6. Fix cptr port scanner bug for process names with spaces (e.g. Next.js 15)
RUN sed -i 's/return int(f.read().split()\[3\])/data = f.read(); return int(data.rsplit(")", 1)[1].split()[1])/' \
    /usr/local/lib/python3.11/dist-packages/cptr/routers/events.py 2>/dev/null || \
    sed -i 's/return int(f.read().split()\[3\])/data = f.read(); return int(data.rsplit(")", 1)[1].split()[1])/' \
    /usr/local/lib/python3.11/site-packages/cptr/routers/events.py 2>/dev/null || true

# 7. Install Starship for a Clean Terminal Prompt
RUN curl -sS https://starship.rs/install.sh | sh -s -- -y

# 8. Setup the 1000 User and Group for Permissions
RUN groupadd -g 1000 cptrgroup && \
    useradd -u 1000 -g 1000 -m -s /bin/zsh cptruser && \
    echo "cptruser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# 9. Switch to the new user context
USER 1000
ENV HOME=/home/cptruser
ENV PATH="$HOME/.local/bin:$PATH"
ENV CHROME_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# 10. Install uv as user (for the Qdrant MCP Server and uvx tools)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# 11. Install chezmoi
RUN sh -c "$(curl -fsLS https://get.chezmoi.io)" -- -b ~/.local/bin

WORKDIR /home/conar/code/sous.tools
EXPOSE 8000

# Startup: sync MCP config from repo SSOT, then start cptr
COPY scripts/mcp-to-cptr.py /usr/local/bin/mcp-to-cptr.py
ENTRYPOINT ["sh", "-c", "export INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=${INFISICAL_CLIENT_ID} --client-secret=${INFISICAL_CLIENT_SECRET} --silent --plain) && infisical run --log-level info --projectId ${INFISICAL_PROJECT_ID} --env ${INFISICAL_ENV:-dev} -- sh -c 'python3 /usr/local/bin/mcp-to-cptr.py; exec cptr run --host 0.0.0.0'"]