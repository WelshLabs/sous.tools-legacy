{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "infisical run --env=${INFISICAL_ENV:-dev} -- nest start",
    "dev": "infisical run --env=${INFISICAL_ENV:-dev} -- nest start --watch --preserveWatchOutput",
    "start:debug": "infisical run --env=${INFISICAL_ENV:-dev} -- nest start --debug --watch --preserveWatchOutput",
    "start:prod": "infisical run --env=${INFISICAL_ENV:-dev} -- node dist/main",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express4": "^1.1.2",
    "@as-integrations/express5": "^1.1.2",
    "@google/genai": "^2.10.0",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.0.0",
    "@soustools/api-types": "workspace:*",
    "@soustools/config": "workspace:*",
    "@soustools/logger": "workspace:*",
    "@supabase/supabase-js": "^2.43.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/graphql-type-json": "^0.3.5",
    "@types/pdf-parse": "^1.1.5",
    "bullmq": "^5.79.0",
    "cache-manager": "^7.2.9",
    "cache-manager-ioredis": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.1",
    "googleapis": "^173.0.0",
    "graphql": "^16.11.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-type-json": "^0.3.2",
    "graphql-ws": "^6.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "neo4j-driver": "^6.2.0",
    "nestjs-cls": "^6.2.1",
    "nestjs-pino": "^4.6.1",
    "newrelic": "^14.1.0",
    "pdf-parse": "^2.4.5",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@soustools/eslint-config": "workspace:*",
    "@soustools/tsconfig": "workspace:*",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "eslint": "^9",
    "jest": "^29.5.0",
    "pino-pretty": "^11.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8",
    "webpack": "^5.108.4",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@soustools/config$": "<rootDir>/../../../packages/config/src/server.ts",
      "^@soustools/config/(.*)$": "<rootDir>/../../../packages/config/src/$1"
    }
  }
}
