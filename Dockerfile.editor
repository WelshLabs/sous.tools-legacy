FROM lscr.io/linuxserver/code-server:latest

USER root

# 1. Install critical system tools, build essentials, GitHub CLI (gh), jq, and ripgrep
RUN apt-get update && apt-get install -y \
    zsh \
    curl \
    git \
    psmisc \
    tmux \
    python3 \
    python3-pip \
    jq \
    ripgrep \
    build-essential \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y gh \
    && curl -sS https://starship.rs/install.sh | sh -s -- -y \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Node.js 22 (replace distro nodejs with current LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 3. Force root user layer context workspace rules
WORKDIR /home/conar/code/sous.tools

# 4. Install global node packages — identical to cptr
RUN npm install -g pnpm pm2 @anthropic-ai/claude-code @modelcontextprotocol/server-github @infisical/cli vercel

# 5. Install Antigravity CLI — matches cptr
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin

# 6. Install python AI applications globally — includes cptr and aider-chat
RUN pip3 install aider-chat "cptr[all]" --break-system-packages

# 7. Install uv (for uvx mcp-server-qdrant, uvx mcp-neo4j-cypher) — matches cptr
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# 8. Install chezmoi (for shared dotfiles across WSL, code-server, cptr)
RUN sh -c "$(curl -fsLS https://get.chezmoi.io)" -- -b /usr/local/bin

# 9. Configure default terminal to zsh
RUN mkdir -p /config/data/User && \
    echo '{"terminal.integrated.defaultProfile.linux": "zsh"}' > /config/data/User/settings.json

# 10. Configure permissions and shell (linuxserver s6-overlay processes PUID at runtime)
RUN chown -R abc:abc /config && usermod -s /bin/zsh abc