# =============================================================================
# SOUS.TOOLS TERMINAL ALIASES & AI COMMIT FUNCTIONS
# Unified across Local WSL Machine, cptr container, and code-server container
# =============================================================================

# --- Detect environment and set SOUS_ROOT ---
if [ -d "/sous.tools" ]; then
  export SOUS_ROOT="/sous.tools"          # cptr container
elif [ -d "/workspace" ]; then
  export SOUS_ROOT="/workspace"           # code-server container
else
  export SOUS_ROOT="$HOME/welshlabs/sous.tools" # WSL native
fi

# Context Engine Shortcut
function ctx() {
  if [ -f "$SOUS_ROOT/docs/context/cto_summary.md" ]; then
    cat "$SOUS_ROOT/docs/context/cto_summary.md"
  else
    echo "No generated cto_summary.md found. Run 'pnpm run context:all' or trigger reporting workflow."
  fi
}

alias c="clear"
alias ls="ls -lah"
alias szsh="source ~/.zshrc"
# alias sous="cd $SOUS_ROOT"

# Infrastructure as Code Stack Management (Single docker-compose.yml)
alias dco='docker compose'
#up() {
#  if [ -f .env ]; then
#    set -a; source .env; set +a
#  fi
#  infisical run --env=$INFISICAL_ENV --projectId=$INFISICAL_PROJECT_ID -- docker compose up -d
#}
alias prod-up='docker compose --profile prod up -d'
alias down='docker compose down'
alias dlogs='docker compose logs -f'
alias traefiklogs='docker compose logs -f traefik'
alias apilogs='docker compose logs -f api'
alias litellm-logs='docker compose logs -f litellm'
alias n8n-logs='docker compose logs -f n8n'
alias cptr-logs='docker compose logs -f cptr'
alias editor-logs='docker compose logs -f code-server'
alias docker-nuke='docker stop $(docker ps -aq) 2>/dev/null; docker system prune -af --volumes'

# Process Management (PM2 Dev Apps)
alias pm2-dev='pm2 start $SOUS_ROOT/ecosystem.config.cjs'
alias pm2-status='pm2 status'
alias pm2-restart='pm2 restart all'
alias pm2-stop='pm2 stop all'
alias pm2-logs='pm2 logs'

# Hosted Supabase Shortcuts (Migration & Type Generation)
alias db-push='npx supabase db push'
alias db-types='npx supabase gen types typescript --project-id ${SUPABASE_PROJECT_ID} > packages/supabase/src/database.types.ts'

# SSH to Production Oracle Server
alias prod-ssh='ssh -i $SOUS_ROOT/ssh-key.key ubuntu@129.158.244.62'

# LLM Gateway Endpoint Export (prod LiteLLM for all environments)
export OPENAI_API_BASE="https://ai.sous.tools/v1"
export OPENAI_API_KEY="sk-1234"

# Git Commit & Push Shortcut
gpush() {
  if [ -z "$1" ]; then
    echo "Error: You must provide a commit message."
    echo "Usage: gpush \"your commit message\""
    return 1
  fi

  git add .
  git commit -m "$1"
  git pull origin main --rebase
  git push origin main
}

# Cross-Environment AI Auto-Commit Function
# Works on both Local WSL Machine and containers via LiteLLM / Gemini Flash
gauto() {
  git add .

  STAGED_DIFF=$(git diff --staged | head -c 4000)
  if [ -z "$STAGED_DIFF" ]; then
    echo "No staged changes to commit."
    return 0
  fi

  echo "Generating AI Conventional Commit Message..."

  # Call prod LiteLLM Endpoint (ai.sous.tools)
  AI_COMMIT_MSG=$(curl -sS https://ai.sous.tools/v1/chat/completions \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer sk-1234" \
    -d '{
      "model": "gemini-3.6-flash",
      "messages": [
        {"role": "system", "content": "You are a git commit assistant. Return ONLY a single line conventional commit message (e.g. feat(scope): description or fix(scope): description) for the provided git diff. Do NOT include markdown code blocks, quotes, or explanations."},
        {"role": "user", "content": "'"${STAGED_DIFF//\"/\\\"}"'"}
      ]
    }' | jq -r '.choices[0].message.content' 2>/dev/null | tr -d '"`\n')

  if [ -z "$AI_COMMIT_MSG" ] || [ "$AI_COMMIT_MSG" = "null" ]; then
    AI_COMMIT_MSG="chore(auto): auto-sync workspace update"
  fi

  echo "AI Commit Message: $AI_COMMIT_MSG"
  git commit -m "$AI_COMMIT_MSG"
  git pull origin main --rebase
  git push origin main
}

# MCP Config Sync (keeps AGY + cptr in sync with repo SSOT)
alias mcp-sync='mkdir -p $HOME/.gemini/config && ln -sf $SOUS_ROOT/mcp_config.json $HOME/.gemini/config/mcp_config.json && echo "✅ MCP config symlinked to repo SSOT"'

alias tailAgent='docker exec agent-runner tail -f /tmp/kanban-orchestrator.log'